{
  "name": "opencodego-pacer",
  "version": "0.1.2",
  "description": "Chrome MV3 extension that paces OpenCode Go subscription usage against its weekly/monthly/rolling reset windows.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package-extension.mjs",
    "render:store-assets": "node scripts/render-store-assets.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.7",
    "vitest": "^3.2.4"
  }
}
